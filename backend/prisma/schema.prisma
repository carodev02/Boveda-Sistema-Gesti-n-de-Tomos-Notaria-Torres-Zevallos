generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  NOTARIO
  SECRETARIA
  ARCHIVADOR
  AUDITOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
  BLOQUEADO
  PENDIENTE
}

enum AuditResult {
  EXITOSO
  ERROR
  DENEGADO
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  username              String?       @unique
  email                 String        @unique
  passwordHash          String
  fullName              String
  phone                 String?
  avatarUrl             String?
  role                  Role
  status                UserStatus    @default(PENDIENTE)
  protectedAccount      Boolean       @default(false)
  lastAccessAt          DateTime?
  failedLoginAttempts   Int           @default(0)
  passwordResetRequired Boolean       @default(false)
  tempPasswordExpiresAt DateTime?
  deletedAt             DateTime?
  deletedBy             String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              UserSession[]
  auditEvents           AuditEvent[]
  documentsCreated      Document[]

  @@index([role, status])
  @@index([deletedAt])
}

model UserSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      String
  module      String
  targetType  String?
  targetId    String?
  detail      String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  result      AuditResult @default(EXITOSO)
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, module, result])
}

model Document {
  id                String       @id @default(uuid()) @db.Uuid
  displayName       String
  originalFileName  String
  storageName       String       @unique
  filePath          String
  fileHash          String       @unique
  fileSize          Int
  mimeType          String
  pageCount         Int
  documentMode      String
  documentType      String
  year              Int?
  biennium          String?
  tomo              String
  fojaInitial       Int?
  fojaFinal         Int?
  escritura         String?
  kardex             String?
  minuta             String?
  actoJuridico      String?
  documentDate      String?
  observations      String?
  ocrConfidence     Float?
  documentStatus    String       @default("En revisión")
  ocrStatus         String       @default("Procesado")
  deletedAt         DateTime?
  deletedBy         String?      @db.Uuid
  createdBy         String       @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdByUser     User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  contractors       DocumentContractor[]

  @@index([documentType, year, biennium, tomo])
  @@index([deletedAt])
  @@index([createdAt])
}

model DocumentContractor {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  name       String
  position   Int      @default(0)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
