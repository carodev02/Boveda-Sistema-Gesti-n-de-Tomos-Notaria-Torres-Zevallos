generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMINISTRADOR
  NOTARIO
  SECRETARIA
  ARCHIVADOR
  AUDITOR
}

enum UserStatus {
  ACTIVO
  INACTIVO
  BLOQUEADO
  PENDIENTE
}

enum AuditResult {
  EXITOSO
  ERROR
  DENEGADO
}

model User {
  id                    String        @id @default(uuid()) @db.Uuid
  username              String?       @unique
  email                 String        @unique
  passwordHash          String
  fullName              String
  phone                 String?
  avatarUrl             String?
  role                  Role
  status                UserStatus    @default(PENDIENTE)
  protectedAccount      Boolean       @default(false)
  lastAccessAt          DateTime?
  failedLoginAttempts   Int           @default(0)
  passwordResetRequired Boolean       @default(false)
  tempPasswordExpiresAt DateTime?
  deletedAt             DateTime?
  deletedBy             String?       @db.Uuid
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  sessions              UserSession[]
  auditEvents           AuditEvent[]
  documentsCreated      Document[]
  processingJobs        DocumentProcessingJob[]

  @@index([role, status])
  @@index([deletedAt])
}

model UserSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  tokenHash      String   @unique
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())
  lastActivityAt DateTime @default(now())
  expiresAt      DateTime
  revokedAt      DateTime?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model AuditEvent {
  id          String      @id @default(uuid()) @db.Uuid
  userId      String?     @db.Uuid
  action      String
  module      String
  targetType  String?
  targetId    String?
  detail      String?
  oldValues   Json?
  newValues   Json?
  ipAddress   String?
  userAgent   String?
  result      AuditResult @default(EXITOSO)
  createdAt   DateTime    @default(now())
  user        User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([action, module, result])
}

model Document {
  id                String       @id @default(uuid()) @db.Uuid
  displayName       String
  originalFileName  String
  storageName       String       @unique
  filePath          String
  fileHash          String       @unique
  fileSize          Int
  mimeType          String
  pageCount         Int
  documentMode      String
  documentType      String
  year              Int?
  biennium          String?
  bienniumStart     Int?
  bienniumEnd       Int?
  tomo              String
  folioRangeStart   Int?
  folioRangeEnd     Int?
  printedFolio      Int?
  fojaInitial       Int?
  fojaFinal         Int?
  escritura         String?
  kardex             String?
  minuta             String?
  actoJuridico      String?
  documentDate      String?
  observations      String?
  ocrConfidence     Float?
  documentStatus    String       @default("En revisión")
  ocrStatus         String       @default("Procesado")
  isTestData        Boolean      @default(false)
  deletedAt         DateTime?
  deletedBy         String?      @db.Uuid
  deletionReason    String?
  createdBy         String       @db.Uuid
  kardexCaseId      String?      @db.Uuid
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  createdByUser     User         @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  contractors       DocumentContractor[]
  processingJob     DocumentProcessingJob?
  kardexCase        KardexCase?  @relation(fields: [kardexCaseId], references: [id], onDelete: SetNull)

  @@index([documentType, year, biennium, tomo])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([kardexCaseId])
}

model KardexCase {
  id                String     @id @default(uuid()) @db.Uuid
  normalizedKardex  String
  periodKey         String
  year              Int?
  bienniumStart     Int?
  bienniumEnd       Int?
  tomeNumber        String
  legalAct          String?
  primaryContractor String?
  status            String
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  documents         Document[]

  @@unique([normalizedKardex, periodKey, tomeNumber])
  @@index([normalizedKardex])
}

enum ProcessingJobStatus {
  UPLOADED
  QUALITY_ANALYSIS
  QUALITY_REVIEW
  OCR_PENDING
  OCR_PROCESSING
  REVIEW_REQUIRED
  READY_TO_SAVE
  SAVING
  COMPLETED
  FAILED
  CANCELLED
}

model DocumentProcessingJob {
  id               String              @id @default(uuid()) @db.Uuid
  originalFileName String
  temporaryPath    String
  fileHash         String
  fileSize         Int
  mimeType         String
  pageCount        Int
  station          String?
  status           ProcessingJobStatus @default(UPLOADED)
  errorMessage     String?
  createdBy        String              @db.Uuid
  documentId       String?             @unique @db.Uuid
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  user             User                @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  document         Document?           @relation(fields: [documentId], references: [id], onDelete: SetNull)
  qualityIssues    QualityIssue[]
  ocrPages         OcrPage[]
  ocrFields        OcrField[]

  @@index([status, createdAt])
  @@index([fileHash])
}

model QualityIssue {
  id              String                @id @default(uuid()) @db.Uuid
  jobId           String                @db.Uuid
  pageNumber      Int
  issueType       String
  severity        String
  message         String
  suggestedAction String?
  createdAt       DateTime              @default(now())
  job             DocumentProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, pageNumber])
}

model OcrPage {
  id         String                @id @default(uuid()) @db.Uuid
  jobId      String                @db.Uuid
  pageNumber Int
  text       String
  confidence Float?
  durationMs Int?
  engine     String?
  createdAt  DateTime              @default(now())
  job        DocumentProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([jobId, pageNumber])
}

model OcrField {
  id              String                @id @default(uuid()) @db.Uuid
  jobId           String                @db.Uuid
  fieldName       String
  extractedValue  String?
  normalizedValue String?
  confidence      Float?
  sourcePage      Int?
  sourceText      String?
  requiresReview  Boolean               @default(false)
  correctedBy     String?               @db.Uuid
  correctedAt     DateTime?
  createdAt       DateTime              @default(now())
  job             DocumentProcessingJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, fieldName])
}

model DocumentContractor {
  id         String   @id @default(uuid()) @db.Uuid
  documentId String   @db.Uuid
  name       String
  position   Int      @default(0)
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
}
