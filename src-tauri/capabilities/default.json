{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos mínimos de SIGADN Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://localhost:4000/api/*" },
        { "url": "http://127.0.0.1:4000/api/*" },
        { "url": "http://:host(192\\.168\\..*):4000/api/*" },
        { "url": "http://:host(10\\..*):4000/api/*" },
        { "url": "http://:host(172\\..*):4000/api/*" }
      ]
    }
  ]
}
