{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bóveda - Notaría Torres Zevallos",
  "mainBinaryName": "Boveda-NTZ",
  "version": "0.1.6",
  "identifier": "pe.notariatorreszevallos.sigadn",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Bóveda - Notaría Torres Zevallos",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": [
      "vision/**/*"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "compression": "zlib"
      }
    }
  }
}
